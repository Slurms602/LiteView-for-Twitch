<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic shared by LiteView.exe and GameFirst.exe: no WinForms, no network, no UI.
       Built for net48 (what ships) and net10.0 (so the unit tests run on any OS). -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <AssemblyName>LiteView.Core</AssemblyName>
    <RootNamespace>LiteView.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1031: catching everything is deliberate at trust boundaries; CA1303: no localisation yet;
         CA1805/CA1810: style; CA2007: no SynchronizationContext concerns in a library this small -->
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1805;CA1810;CA2007;CA1716;CA1720;CA1711;CA1062;CA1308;CA1819;CA1002;CA1051;CA1305;CA1307;CA1310;CA1309;CA1847;CA1865;CA1866;CA1872;CA5394;CA1845;CA1835;CA1870;CA1510;CA2249</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LiteView.Core.Tests" />
  </ItemGroup>
</Project>
